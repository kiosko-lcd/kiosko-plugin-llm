{
  "name": "kiosko-plugin-llm",
  "version": "0.1.0",
  "description": "Tokens per second, loaded models and request queues of your local LLM servers.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "widgets",
    "dev"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-llm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-llm.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-llm/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "llm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@kiosko/sdk": "^0.1.0",
    "@loksly/lcd-canvas-kit": "^0.1.0",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
